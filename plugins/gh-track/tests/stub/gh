#!/usr/bin/env bash
# Recording gh stub. Logs every invocation and replays canned responses.
#
# Contract:
#   $GH_STUB_LOG        - file; one line per call, the joined arguments
#   $GH_STUB_RESPONSES  - file; TAB-separated: PATTERN <TAB> EXIT <TAB> [STDOUT_FILE]
#   $GH_STUB_LOG.body   - snapshot of the last --body-file argument's
#                         content, taken right now, at call time
#   $GH_STUB_UNMATCHED  - file; one line per unmatched call whose stdout the
#                         production code parses (see below)
#   $GH_STUB_ALLOW_UNMATCHED=1 - opt out of that recording
#
# The first response whose PATTERN occurs as a substring of the joined
# arguments wins. With no match: exit 0, empty stdout. This keeps tests
# declarative — a test states only the calls it cares about.
#
# But for a call whose OUTPUT the code under test reads, "no canned
# response" is byte-identical to a legitimate empty API result, and
# production code treats empty as authoritative state ("no labels", "no
# comment exists"). A missing or misspelled pattern therefore reroutes a
# test onto its degraded path with every assertion still passing. So an
# unmatched READ is recorded to $GH_STUB_UNMATCHED, which `report` fails on.
# Unmatched WRITES stay silent: their stdout is discarded by the caller, and
# requiring a canned response for every `label create` would be noise.
set -uo pipefail

args="$*"
printf '%s\n' "$args" >>"${GH_STUB_LOG:?GH_STUB_LOG unset}"

# Callers that invoke the real `ghtrack` binary (rather than sourcing its
# library functions) write --body-file to a mktemp scratch dir that a caller
# EXIT trap deletes the moment that process exits -- which happens before
# control ever returns to the test. Snapshotting the content here, while the
# file still exists mid-call, is the only point it can be captured.
body_file=""
prev=""
for a in "$@"; do
  if [ "$prev" = "--body-file" ]; then body_file=$a; fi
  prev=$a
done
if [ -n "$body_file" ] && [ -f "$body_file" ]; then
  cp "$body_file" "${GH_STUB_LOG}.body" 2>/dev/null || true
fi

# Real gh applies --jq to its JSON output. The stub must too, or every
# test whose code path uses --jq would assert against raw JSON.
jq_filter=""
prev=""
for a in "$@"; do
  if [ "$prev" = "--jq" ]; then jq_filter=$a; fi
  prev=$a
done

emit() {
  local f=$1
  if [ -n "$jq_filter" ] && command -v jq >/dev/null 2>&1; then
    jq -r "$jq_filter" <"$f" 2>/dev/null || true
  else
    cat "$f"
  fi
}

if [ -n "${GH_STUB_RESPONSES:-}" ] && [ -f "$GH_STUB_RESPONSES" ]; then
  while IFS="$(printf '\t')" read -r pattern code outfile; do
    [ -n "${pattern:-}" ] || continue
    case "$args" in
      *"$pattern"*)
        if [ -n "${outfile:-}" ] && [ -f "$outfile" ]; then
          emit "$outfile"
        fi
        exit "${code:-0}"
        ;;
    esac
  done <"$GH_STUB_RESPONSES"
fi

# Nothing matched. Decide whether this call's stdout is load-bearing.
is_read=0
case " $args " in
  *" --json "*|*" --jq "*|*" --format "*|*"auth status"*) is_read=1 ;;
esac
case "${1:-}" in
  api) is_read=1 ;;
esac
# `gh issue create` carries no --json/--jq/--format, so the flag test above
# classified it as a write and stayed silent -- yet cmd_new PARSES its stdout
# (the printed URL is where the issue number comes from). A misspelled canned
# response therefore produced an empty number, exit 0, and no UNMATCHED line.
# Classification follows what the caller does with stdout, not the flags.
case " $args " in
  *" issue create "*) is_read=1 ;;
esac
# A mutating REST call's response body is not read back for state.
case " $args " in
  *" -X PATCH "*|*" -X POST "*|*" -X PUT "*|*" -X DELETE "*) is_read=0 ;;
esac

if [ "$is_read" = 1 ] && [ "${GH_STUB_ALLOW_UNMATCHED:-0}" != "1" ] \
   && [ -n "${GH_STUB_UNMATCHED:-}" ]; then
  printf 'UNMATCHED: %s\n' "$args" >>"$GH_STUB_UNMATCHED"
fi

exit 0
